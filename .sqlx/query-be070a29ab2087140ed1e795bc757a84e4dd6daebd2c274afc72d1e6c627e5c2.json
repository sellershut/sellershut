  "db_name": "PostgreSQL",
  "query": "\n                select u.*, k.public_key from actor as u\n                join \"oauth_identity\" as oi on u.id = oi.user_id\n                join actor_key as k on k.actor_id = oi.user_id\n                where\n                    oi.provider_email = $1\n                    and u.is_local\n                for update\n            ",
