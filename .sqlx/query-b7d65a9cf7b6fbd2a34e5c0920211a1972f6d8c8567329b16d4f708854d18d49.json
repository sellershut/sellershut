{
  "db_name": "PostgreSQL",
  "query": "\n            select u.*,k.public_key\n            from auth_session as s\n            join actor as u on u.id = s.user_id\n            join actor_key as k on k.actor_id = s.user_id\n            where s.token_hash = $1\n              and s.expires_at > now()\n            ",
