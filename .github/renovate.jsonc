{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": true,
  "automergeType": "branch",
  "semanticCommits": "enabled",
  "schedule": [
    "* 0-3 1 * *" // Schedule once a month on the first day of the month before 4 AM.
  ]
}
